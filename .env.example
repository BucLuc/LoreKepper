NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server only. Generate once using the command in SUPABASE.md. Keep a backup.
LORE_ENCRYPTION_KEY=YOUR_64_CHARACTER_HEX_KEY
# Server only. Supabase project settings > API > service_role (never NEXT_PUBLIC).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Optional shared AI, used when the funding user has no personal key.
LORE_AI_PROVIDER=groq
LORE_AI_MODEL=openai/gpt-oss-120b
LORE_AI_KEY=
# Weighted daily allowance: story turn = 6; chat transformation = 1.
LORE_AI_DAILY_UNITS=60
LORE_AI_GLOBAL_UNITS=600
# ChatGPT Actions OAuth: configure these only on the server and in the GPT editor.
# This mode does not need an OpenAI API key.
LORE_PUBLIC_URL=https://your-lorekeeper.example
LORE_GPT_CLIENT_ID=
LORE_GPT_CLIENT_SECRET=
# Exact callback shown by the GPT editor: https://chatgpt.com/aip/g-.../oauth/callback
LORE_GPT_REDIRECT_URI=
